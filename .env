# Copy this file to .env and fill in your values.
# Never commit .env to Git.

# MySQL connection
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=Admin@123
DB_NAME=hamiltonTheatredb

# Admin credentials
ADMIN_USERNAME=admin

# Preferred: a bcrypt hash of your admin password. Generate one with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
# then paste the result below.
ADMIN_PASSWORD_HASH=Admin@123

# Legacy fallback: only used if ADMIN_PASSWORD_HASH is left blank above.
# Fine for local development, but don't deploy with a plaintext password set.
ADMIN_PASSWORD=Admin@123

# JWT secret — generate a strong random string for production
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production-please

# Comma-separated list of allowed frontend origins, e.g.
#   CORS_ORIGINS=https://your-frontend.pages.dev,https://yourdomain.com
# Leave unset (or "*") to allow all origins — fine for local dev only.
CORS_ORIGINS=*
