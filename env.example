# Copy this file to .env and fill in your values.
# Never commit .env to Git.

# MySQL connection
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=reelkartTheatresdb

# Admin credentials
ADMIN_USERNAME=admin

# Preferred: a bcrypt hash of your admin password. Generate one with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
# then paste the result below.
ADMIN_PASSWORD_HASH=

# Legacy fallback: only used if ADMIN_PASSWORD_HASH is left blank above.
# Fine for local development, but don't deploy with a plaintext password set.
ADMIN_PASSWORD=your_admin_password_here

# JWT secret — generate a strong random string for production
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production-please

# Comma-separated list of allowed frontend origins, e.g.
#   CORS_ORIGINS=https://your-frontend.pages.dev,https://yourdomain.com
# Leave unset (or "*") to allow all origins — fine for local dev only.
CORS_ORIGINS=*

# Email confirmations (SendGrid) — optional. Leave SENDGRID_API_KEY blank to
# disable; bookings still work fine, they just skip sending an email.
# 1. Sign up free at https://sendgrid.com (100 emails/day free tier)
# 2. Settings -> API Keys -> Create API Key (Full Access or "Mail Send" only)
# 3. Settings -> Sender Authentication -> verify a "Single Sender" email
#    (that verified address is what SENDGRID_FROM_EMAIL must be)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@reelkarttheatres.example
SENDGRID_FROM_NAME=ReelKart Theatres
